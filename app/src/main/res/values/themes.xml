<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Theme used once the app is running (Compose draws everything). -->
    <style name="Theme.AIDocumentOrganizer" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
        Launch theme: the single system splash screen (Android 12+ and the
        androidx compat splash on older versions). It shows the app icon once,
        then hands over to Theme.AIDocumentOrganizer.
    -->
    <style name="Theme.AIDocumentOrganizer.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.AIDocumentOrganizer</item>
    </style>

</resources>
